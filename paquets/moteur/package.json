      "types": "./dist/projection/index.d.ts",
      "default": "./dist/projection/index.js"
    }
  },
  "scripts": {
    "types": "tsc --noEmit -p tsconfig.json",
    "construire": "tsc -p tsconfig.construire.json"
  },
  "dependencies": {
    "@gdv/partage": "1.0.0"
  },
  "devDependencies": {
    "fast-check": "3.23.2"
  }
}
