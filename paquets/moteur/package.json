{
  "name": "@gdv/moteur",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MOTEUR PUR — déterministe, sans E/S, sans horloge ni aléa non injectés. Testable sans serveur.",
  "exports": {
    ".": {
      "gdv-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
