{
  "name": "gdv",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Le Génie du Dernier Vœu — mono-repo npm workspaces (ARCHI-GDV-001, ADR-TL-11)",
  "license": "LicenseRef-proprietaire",
  "workspaces": [
    "paquets/*",
    "applications/*"
  ],
  "engines": {
    "node": ">=24.18.1 <25"
  },
  "scripts": {
    "installer": "npm install",
    "verifier": "npm run secrets && npm run verifier:visibilite && npm run types && npm run lint && npm run verifier:couches && npm run test && npm run couverture && npm run audit",
    "jetons": "node outils/compiler-jetons.mjs",
    "jetons:verifier": "node outils/compiler-jetons.mjs --verifier",
    "secrets": "node outils/verifier-secrets.mjs",
    "verifier:visibilite": "node outils/verifier-visibilite.mjs",
    "types": "npm run types --workspaces --if-present",
    "lint": "eslint .",
    "verifier:couches": "node outils/verifier-couches.mjs",
    "test": "node --conditions=gdv-source --test",
    "couverture": "node outils/verifier-couverture.mjs",
    "audit": "npm audit --audit-level=high",
    "dev": "node outils/dev.mjs",
    "dev:serveur": "npm run dev --workspace @gdv/serveur",
    "dev:client": "npm run dev --workspace @gdv/client",
    "construire": "npm run construire --workspaces --if-present",
    "migrer": "npm run migrer --workspace @gdv/serveur",
    "rejouer": "npm run rejouer --workspace @gdv/serveur"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.19.2",
    "c8": "10.1.3",
    "dependency-cruiser": "18.7.0",
    "eslint": "9.39.5",
    "eslint-plugin-vue": "10.12.0",
    "globals": "17.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vue-eslint-parser": "10.4.1"
  }
}
