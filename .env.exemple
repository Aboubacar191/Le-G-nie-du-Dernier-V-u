# Le Génie du Dernier Vœu — variables d'environnement du serveur.
# Fichier d'EXEMPLE : il documente les clés, il ne contient AUCUNE valeur réelle.
# Copier en .env (ignoré par git) pour un poste de développement.
# Clés normatives : ARCHI-GDV-001.json / conventions.arborescence_depot.fichiers_racine.

# Port d'écoute du serveur HTTP + WebSocket (même origine).
PORT=8443

# Interface d'écoute. 127.0.0.1 en développement ; 0.0.0.0 pour un playtest en salle.
HOTE=127.0.0.1

# Chemin du fichier SQLite unique (journal WAL, foreign_keys=ON).
# Le fichier et ses journaux sont ignorés par git.
CHEMIN_BDD=./donnees/gdv.sqlite

# Origine autorisée à la mise à niveau WebSocket (contrôle d'origine, ADR-TL-16).
ORIGINE_AUTORISEE=https://localhost:5173

# developpement | production. En production, le serveur REFUSE de démarrer
# sans CHEMIN_CERT et CHEMIN_CLE (standards.transport_chiffre : https/wss obligatoires).
MODE=developpement

# Certificat et clé privée TLS. Jamais versionnés (voir .gitignore : *.pem, *.key).
CHEMIN_CERT=
CHEMIN_CLE=
